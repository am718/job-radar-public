# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
PRICE_IN_PER_MTOK=2
PRICE_OUT_PER_MTOK=10

# sync:pull (run on the MacBook): pull data/jobs.db and digest/ from the Mac Mini over Tailscale
SYNC_HOST=
SYNC_USER=
# path of the project on the Mac Mini, relative to that user's home (default Dev/job-radar)
SYNC_REMOTE_DIR=Dev/job-radar
