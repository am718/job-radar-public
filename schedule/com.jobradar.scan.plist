<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobradar.scan</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>-lc</string><string>cd REPLACE_WITH_ABSOLUTE_PATH/job-radar &amp;&amp; npm run scan</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>EnvironmentVariables</key><dict><key>TZ</key><string>America/New_York</string></dict>
  <key>StandardOutPath</key><string>/tmp/jobradar.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/jobradar.err.log</string>
</dict>
</plist>
